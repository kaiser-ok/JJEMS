[Unit]
Description=JJEMS MQTT Log Ingest Collector
Documentation=file:/home/gentrice/jjems/service.md
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=gentrice
Group=gentrice
WorkingDirectory=/home/gentrice/jjems
Environment=DATABASE_URL=postgres://ems:ems_dev_only_change_me@localhost:5432/ems
ExecStart=/home/gentrice/jjems/scripts/hiems_mqtt_log_ingest_cron.sh
NoNewPrivileges=true
PrivateTmp=true
